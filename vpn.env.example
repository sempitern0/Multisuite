# Red privada (docs/VPN.md). Copy to ignored vpn.env to enable `make vpn-*`; without vpn.env nothing
# of this stack runs and local development is unchanged. Only names, ports and addresses here:
# DNS provider credentials go in vpn.secrets.env.
VPN_PROJECT_NAME=multisuite-vpn
HEADSCALE_IMAGE=headscale/headscale:0.29.8
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.7
TRAEFIK_IMAGE=traefik:v3.8.0

# --- Coordination server (where devices sign in) -------------------------------------------
# Local test on this computer (default): HTTP on loopback, no domain needed.
VPN_SERVER_URL=http://127.0.0.1:8090
VPN_BIND_IP=127.0.0.1
VPN_CONTROL_PORT=8090
VPN_LISTEN_PORT=8080
VPN_ACME_PORT=8089
VPN_CONTROL_DOMAIN=
VPN_ACME_EMAIL=
# Public server: the control name must resolve to the server's public address and ports 80 and
# 443 must reach it (only Headscale is published; the portal and the services stay private).
# VPN_SERVER_URL=https://vpn.example.org
# VPN_CONTROL_DOMAIN=vpn.example.org
# VPN_ACME_EMAIL=admin@example.org
# VPN_BIND_IP=0.0.0.0
# VPN_CONTROL_PORT=443
# VPN_LISTEN_PORT=443
# VPN_ACME_PORT=80

# Name of the devices inside the network (never the same domain as VPN_CONTROL_DOMAIN).
VPN_MAGIC_DOMAIN=red.multisuite.internal

# --- Private names (only resolvable inside the network) ------------------------------------
# Empty disables that entry. With VPN_TLS=acme-dns use names of a domain you control.
VPN_PORTAL_HOST=multisuite.multisuite.internal
VPN_MUSIC_HOST=musica.multisuite.internal
VPN_READING_HOST=lectura.multisuite.internal
VPN_VIDEO_HOST=video.multisuite.internal

# --- HTTPS for the private names -----------------------------------------------------------
# none: HTTP inside the network (WireGuard already encrypts it; browsers show "not secure").
# acme-dns: Let's Encrypt certificates by DNS challenge; needs a domain, VPN_ACME_EMAIL and
# VPN_DNS_PROVIDER (lego code: cloudflare, ovh, duckdns, gandiv5…) with vpn.secrets.env.
VPN_TLS=none
VPN_DNS_PROVIDER=
