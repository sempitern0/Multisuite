# vpn.env — Red privada con Headscale (compose.vpn.yaml). Guía: docs/VPN.md
# Activar: cp vpn.env.example vpn.env; luego `make vpn-up` y `make vpn-join`. `make up` nunca la
# arranca. Solo nombres, puertos y direcciones: las credenciales DNS van en vpn.secrets.env.

# --- Contenedores --------------------------------------------------------------------------
VPN_PROJECT_NAME=multisuite-vpn
HEADSCALE_IMAGE=headscale/headscale:0.29.8
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.7
TRAEFIK_IMAGE=traefik:v3.8.0

# --- Servidor de coordinación (donde los dispositivos inician sesión) -----------------------
# Prueba local en este equipo (por defecto): HTTP en loopback, sin dominio.
# Dirección que ponen los dispositivos en «servidor alternativo». Sin barra final.
VPN_SERVER_URL=http://127.0.0.1:8090
# Dónde escucha en este equipo: 127.0.0.1 solo aquí; 0.0.0.0 en el servidor público.
VPN_BIND_IP=127.0.0.1
# Puerto publicado (VPN_CONTROL_PORT) y puerto dentro del contenedor (VPN_LISTEN_PORT).
VPN_CONTROL_PORT=8090
VPN_LISTEN_PORT=8080
# Puerto 80 para el certificado de Let's Encrypt de Headscale (solo útil en el servidor público).
VPN_ACME_PORT=8089
# Nombre público del servidor de coordinación; vacío en la prueba local.
VPN_CONTROL_DOMAIN=
VPN_ACME_EMAIL=
# Servidor público: el nombre debe apuntar a su IP pública y los puertos 80 y 443 llegar a él
# (solo se publica Headscale; el portal y los servicios siguen privados).
# VPN_SERVER_URL=https://vpn.example.org
# VPN_CONTROL_DOMAIN=vpn.example.org
# VPN_ACME_EMAIL=admin@example.org
# VPN_BIND_IP=0.0.0.0
# VPN_CONTROL_PORT=443
# VPN_LISTEN_PORT=443
# VPN_ACME_PORT=80

# Dominio de los nombres de los dispositivos dentro de la red. Nunca el de VPN_CONTROL_DOMAIN.
VPN_MAGIC_DOMAIN=red.multisuite.internal

# --- Nombres privados (solo se resuelven dentro de la red) ---------------------------------
# Vacío desactiva esa entrada. Con VPN_TLS=acme-dns, nombres de un dominio que controles.
# `make vpn-urls` imprime las líneas que hay que copiar a app/.env y a cada servicio.
VPN_PORTAL_HOST=multisuite.multisuite.internal
VPN_MUSIC_HOST=musica.multisuite.internal
VPN_READING_HOST=lectura.multisuite.internal
VPN_VIDEO_HOST=video.multisuite.internal

# --- HTTPS para los nombres privados -------------------------------------------------------
# none: HTTP dentro de la red (WireGuard ya lo cifra; el navegador lo marca «no seguro»).
# acme-dns: certificados de Let's Encrypt por desafío DNS; necesita un dominio, VPN_ACME_EMAIL y
# VPN_DNS_PROVIDER (código de lego: cloudflare, ovh, duckdns, gandiv5…) con vpn.secrets.env.
VPN_TLS=none
VPN_DNS_PROVIDER=
