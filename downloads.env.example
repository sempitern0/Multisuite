# downloads.env — Descargas con MeTube para owner y administradores (compose.downloads.yaml).
# Guía: docs/DOWNLOADS.md. Activar: cp downloads.env.example downloads.env; `make up` la arranca y
# da al portal la carpeta de espera (DOWNLOADS_AUTO=0 lo salta). Nada secreto aquí.

# --- Contenedores --------------------------------------------------------------------------
DOWNLOADS_PROJECT_NAME=multisuite-downloads
METUBE_IMAGE=ghcr.io/alexta69/metube:2026.11.24
# Dueño de lo que descarga MeTube: el usuario del portal (DEV_UID/DEV_GID del .env raíz).
DOWNLOADS_UID=1000
DOWNLOADS_GID=1000

# --- Acceso --------------------------------------------------------------------------------
# Puerto en este equipo (solo 127.0.0.1) y dirección que abre el portal (`make up` se la pasa).
# Con la red privada, el nombre privado que elijas.
DOWNLOADS_PORT=8084
PORTAL_DOWNLOADS_URL=http://127.0.0.1:8084

# --- Límites -------------------------------------------------------------------------------
# Tamaño máximo de una descarga, en bytes (20 GiB). Guardar en Mis archivos comprueba además
# la cuota de quien lo guarda.
DOWNLOADS_MAX_FILE_BYTES=21474836480
