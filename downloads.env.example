# Descargas (docs/DOWNLOADS.md). Copy to ignored downloads.env to enable it: `make up` then starts
# MeTube and gives the portal the staging folder. Only owner and administrators can use it.
DOWNLOADS_PROJECT_NAME=multisuite-downloads
METUBE_IMAGE=ghcr.io/alexta69/metube:2026.11.24
# Address people open (loopback until the private network, VPN.md, gives it a private name).
DOWNLOADS_PORT=8084
PORTAL_DOWNLOADS_URL=http://127.0.0.1:8084
# Largest single download yt-dlp may write (20 GiB). Saving into Mis archivos still checks quota.
DOWNLOADS_MAX_FILE_BYTES=21474836480
# Owner of the files MeTube writes: the portal's user (DEV_UID/DEV_GID in development).
DOWNLOADS_UID=1000
DOWNLOADS_GID=1000
