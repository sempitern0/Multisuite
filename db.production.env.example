# db.production.env — PostgreSQL en producción (compose.production.yaml, como DB_ENV_FILE).
# Activar: cp db.production.env.example db.production.env. Mismos valores que DB_* en
# app.production.env. Secreto: nunca en git.
POSTGRES_DB=multisuite
POSTGRES_USER=multisuite
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
