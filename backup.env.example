# Copy to backup.env (ignored by Git, kept at mode 600). KEY=VALUE, without quotes.
# Used by make nas-backup on the Linux server; see docs/STORAGE.md.

# Without this password the backup cannot be read. Keep a copy OUTSIDE the server,
# together with NAS_FILES_KEY from app/.env (private files are stored encrypted with it).
RESTIC_PASSWORD=

# Destination, one of:
# a) External disk already mounted on the server (never a partition of a data disk).
BACKUP_REPOSITORY_PATH=
# b) Remote repository (sftp:, rest:, s3:, b2: ...) plus the credentials restic expects.
RESTIC_REPOSITORY=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# How many copies to keep.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Share of the stored data re-read after every run to detect corruption.
BACKUP_CHECK_SUBSET=10%
# Extra host folders, separated by spaces (for example the music library).
BACKUP_EXTRA_PATHS=
# Rehearsals only: allow a repository on the same disk as the data.
BACKUP_ALLOW_SAME_DISK=0
RESTIC_IMAGE=restic/restic:0.19.1
