# backup.env — Copia de seguridad del NAS con restic (`make nas-backup`, en el servidor Linux).
# Guía: docs/STORAGE.md § Copia. Activar: cp backup.env.example backup.env y `chmod 600 backup.env`.
# Contiene secretos: nunca en git. KEY=VALUE sin comillas.

# --- Cifrado -------------------------------------------------------------------------------
# Sin esta contraseña la copia no se puede leer. Guarda otra copia FUERA del servidor, junto con
# NAS_FILES_KEY de app/.env (los archivos privados están cifrados con ella).
RESTIC_PASSWORD=

# --- Destino (elige uno) -------------------------------------------------------------------
# a) Disco externo ya montado en el servidor (nunca una partición de un disco de datos).
BACKUP_REPOSITORY_PATH=
# b) Repositorio remoto (sftp:, rest:, s3:, b2:…) más las credenciales que restic espera.
RESTIC_REPOSITORY=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- Conservación y comprobación -----------------------------------------------------------
# Cuántas copias diarias, semanales y mensuales se guardan.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Parte de lo guardado que se vuelve a leer tras cada copia para detectar corrupción.
BACKUP_CHECK_SUBSET=10%
# Carpetas extra del servidor, separadas por espacios (por ejemplo la biblioteca de música).
BACKUP_EXTRA_PATHS=
# Solo para ensayos: permite un repositorio en el mismo disco que los datos.
BACKUP_ALLOW_SAME_DISK=0
RESTIC_IMAGE=restic/restic:0.19.1
