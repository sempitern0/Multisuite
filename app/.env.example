# app/.env — Laravel (el portal); lo crea `make up` y lo mantiene al día con el .env raíz.
# `make up` copia del .env raíz la base de datos, el correo y las colas. Índice: `make env-list`.
# En desarrollo, `make up` fija por su cuenta muchas variables de servicios (overlays de deploy/)
# y esas mandan sobre lo escrito aquí: lo de abajo es lo que vale sin overlay, como en producción.

# --- Aplicación ----------------------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=local
# Clave de cifrado (sesiones, tickets de servicios, claves de IA). La genera `make up`.
APP_KEY=
APP_DEBUG=true
# Dirección con la que se abre el portal (con la red privada, `make vpn-urls` da la correcta).
APP_URL=http://localhost:8000
# Redes de proxies cuyas cabeceras X-Forwarded-* se creen (la entrada privada, docs/VPN.md),
# separadas por comas. Vacío: ninguna.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos, sesiones y colas (en desarrollo, `make up` los copia del .env raíz) -------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Correo --------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Valores estándar de Laravel que Multisuite no usa hoy ---------------------------------
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================================================================
# Multisuite. Por servicio, tres tipos de variable que se confunden a menudo:
#   PORTAL_*_ENABLED / PORTAL_*_URL  → la tarjeta de la portada y la dirección que abre el navegador.
#   *_PROVISIONING_ENABLED            → el portal crea y sincroniza las cuentas en ese servicio.
#   *_INTERNAL_URL                    → cómo llega el portal al servicio dentro de Docker
#                                       (nombre del contenedor; nunca localhost).
# ===========================================================================================

# --- Mis finanzas --------------------------------------------------------------------------
# false lo oculta a todas las personas.
PORTAL_FINANCES=true

# --- Música (Navidrome, music.env) ---------------------------------------------------------
# localhost solo funciona en el propio servidor; desde otros equipos, su dirección real.
PORTAL_MUSIC_ENABLED=false
PORTAL_MUSIC_URL=http://127.0.0.1:4533
NAVIDROME_PROVISIONING_ENABLED=false
NAVIDROME_INTERNAL_URL=
# Cuenta de administración de Navidrome que usa el portal (solo en el servidor; nunca en git).
NAVIDROME_ADMIN_USERNAME=
NAVIDROME_ADMIN_PASSWORD=
# Entrada sin segundo inicio de sesión a través de la pasarela (docker/music-proxy). Con
# music.env, `make up` usa los valores del .env raíz; fuera de ahí, actívalos solo tras la pasarela.
NAVIDROME_SESSION_BRIDGE_ENABLED=false
NAVIDROME_AUTOLOGIN_ENABLED=false

# --- Lectura con Kavita (reading.env; hoy desactivada en favor de Komga) ---------------------
# Con reading.env y READING_AUTO=1, `make up` fija estas variables; `portal:reading-setup` crea
# la cuenta del operador. En producción: rellénalas aquí y ejecuta portal:reading-setup una vez.
PORTAL_READING_ENABLED=false
PORTAL_READING_URL=http://127.0.0.1:5000
KAVITA_PROVISIONING_ENABLED=false
KAVITA_INTERNAL_URL=
KAVITA_ADMIN_USERNAME=
KAVITA_ADMIN_PASSWORD=
# KAVITA_AUTOLOGIN_ENABLED=false

# --- Lectura con Komga (arranca con el NAS de desarrollo) ----------------------------------
# `make up` lo activa en desarrollo; autoriza su API desde Administración → Conectar Lectura.
KOMGA_PROVISIONING_ENABLED=false
# PORTAL_KOMGA_ENABLED=false
# PORTAL_KOMGA_URL=http://127.0.0.1:25600
# KOMGA_INTERNAL_URL=http://komga-gateway:8080

# --- Vídeo (Jellyfin, video.env; `make up` las fija desde video.env) ------------------------
# PORTAL_VIDEO_ENABLED=false
# PORTAL_VIDEO_URL=http://127.0.0.1:8096
# JELLYFIN_PROVISIONING_ENABLED=false
# JELLYFIN_INTERNAL_URL=http://jellyfin:8096
# intel, amd, nvidia o none: la escribe `make video-detect` en video.env.
# VIDEO_HARDWARE=none

# --- Descargas (MeTube, downloads.env; `make up` las fija desde downloads.env) --------------
# PORTAL_DOWNLOADS_ENABLED=false
# PORTAL_DOWNLOADS_URL=http://127.0.0.1:8084
# Carpeta de espera dentro del contenedor del portal (volumen multisuite-downloads).
# DOWNLOADS_STAGING_PATH=/srv/downloads

# --- Almacenamiento y Mis archivos (docs/STORAGE.md) ---------------------------------------
# Ubicaciones del NAS que declara el operador, como JSON (rutas dentro del contenedor del
# portal). Vacío por defecto; `make nas-apply` las escribe en el servidor. Nunca las elige la web.
NAS_STORAGE_VOLUMES='[]'
# Cifrado en reposo de los archivos privados. NAS_FILES_KEY la crea portal:files-key (`make up`
# en desarrollo). Guarda una copia FUERA del servidor: sin ella los archivos no se pueden leer.
NAS_ENCRYPT_FILES=true
NAS_FILES_KEY=
# Subidas a Mis archivos y la ubicación (de NAS_STORAGE_VOLUMES) donde se guardan. En desarrollo
# las activa el NAS de desarrollo; en el servidor, `make nas-apply`.
NAS_UPLOADS_ENABLED=false
NAS_UPLOAD_LOCATION=
# Tope de seguridad por archivo, en bytes (100 GiB). Las subidas viajan en trozos de 8 MiB, así
# que los límites de Nginx/PHP no aplican; el límite real es el espacio de cada persona.
NAS_UPLOAD_MAX_BYTES=107374182400
# Ajustes con valor por defecto razonable (descoméntalos solo para cambiarlos):
# NAS_TRASH_DAYS=30                       # días en la papelera antes de borrar del todo
# NAS_MAX_VERSIONS=5                      # versiones anteriores que se guardan de cada archivo
# NAS_OPTIMIZE_IMAGES=true                # optimización sin pérdida de JPEG al subir
# NAS_OPTIMIZE_MAX_BYTES=67108864         # no optimiza imágenes más grandes (64 MiB)
# NAS_STRIP_IMAGE_METADATA=true           # quita GPS, cámara y fechas de las fotos (si no puede, rechaza)
# NAS_EXPORT_SYNC_MAX_BYTES=52428800      # ZIP hasta 50 MiB al momento; más grandes, en segundo plano
# NAS_EXPORT_TTL_HOURS=24                 # horas que se conserva un ZIP preparado
# NAS_BOOTSTRAP_DEFAULT_QUOTA_BYTES=0     # solo desarrollo: espacio por persona si no hay ninguno elegido
# Escritas en el servidor por `make nas-discover` y `make nas-backup` (solo se muestran):
# NAS_HARDWARE_SNAPSHOT=
# NAS_BACKUP_STATUS=
# NAS_BACKUP_MAX_AGE_HOURS=48             # una copia más antigua se marca como atrasada

# --- Asistente y clientes externos (docs/MCP.md) -------------------------------------------
# Claves de firma OAuth para clientes externos (MCP-05): `make up` las crea en storage/ en
# desarrollo; en producción ponlas aquí (PEM de varias líneas) o ejecuta passport:keys una vez.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
# A qué direcciones pueden devolver los clientes externos tras conectar (prefijos separados por comas).
# MCP_REDIRECT_DOMAINS=https://claude.ai/,https://claude.com/,https://chatgpt.com/,http://localhost,http://127.0.0.1
# Esquemas propios de apps de escritorio admitidos también como vuelta (p. ej. cursor), separados por comas.
# MCP_CUSTOM_SCHEMES=
