includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Used by Livewire single-file components (resources/views/pages), which PHPStan does not analyse.
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/NotifiesInterface.php
