# app.production.env — Laravel en producción (compose.production.yaml); plantilla heredada, la adapta P05.
# compose.production.yaml la lee como APP_ENV_FILE. Guía: docs/foundry/DEPLOYMENT.md
# Activar: cp app.production.env.example app.production.env y sustituir cada REPLACE_*. Secretos:
# nunca en git. Las variables de Multisuite (servicios, NAS, red privada) son las de app/.env.example.

APP_NAME=Multisuite
APP_ENV=production
APP_DEBUG=false
# Dirección con la que se abre el portal (con la red privada, VPN_PORTAL_HOST).
APP_URL=https://example.com
# `php artisan key:generate --show`. Cifra sesiones, tickets y archivos: guárdala fuera del servidor.
APP_KEY=REPLACE_WITH_GENERATED_APP_KEY
LOG_CHANNEL=stderr

# --- Base de datos (los mismos valores que db.production.env) -------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=multisuite
DB_USERNAME=multisuite
DB_PASSWORD=REPLACE_WITH_SAME_LONG_RANDOM_SECRET

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
MAIL_MAILER=log
