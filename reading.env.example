# Copy to ignored reading.env to start Lectura (Kavita) with `make up`; paths are relative to
# compose.reading.yaml. Each library folder holds books as files (EPUB, PDF, CBZ/CBR…).
READING_PROJECT_NAME=multisuite-reading
KAVITA_IMAGE=jvmilazz0/kavita:0.9.1
KAVITA_PORT=5000
KAVITA_TZ=Europe/Madrid
KAVITA_BOOKS_PATH=./local/kavita/books
KAVITA_COMICS_PATH=./local/kavita/comics
KAVITA_MANGA_PATH=./local/kavita/manga
KAVITA_DOCS_PATH=./local/kavita/docs
