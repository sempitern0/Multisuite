# reading.env — Lectura con Kavita, hoy desactivada en favor de Komga (compose.reading.yaml).
# Guía: docs/KAVITA.md. Con este archivo, `make up` para Kavita salvo que READING_AUTO=1.
# Solo nombres, puertos y rutas; las rutas son relativas a la raíz. Komga no necesita archivo:
# arranca solo con el NAS de desarrollo (KOMGA_PORT, si quieres otro puerto, va en el .env raíz).

# --- Contenedores --------------------------------------------------------------------------
READING_PROJECT_NAME=multisuite-reading
KAVITA_IMAGE=jvmilazz0/kavita:0.9.1
KAVITA_TZ=Europe/Madrid

# --- Acceso --------------------------------------------------------------------------------
# Puerto en este equipo. La dirección que abre el portal es PORTAL_READING_URL en app/.env.
KAVITA_PORT=5000

# --- Bibliotecas (carpetas con libros como archivos: EPUB, PDF, CBZ/CBR…) -------------------
KAVITA_BOOKS_PATH=./local/kavita/books
KAVITA_COMICS_PATH=./local/kavita/comics
KAVITA_MANGA_PATH=./local/kavita/manga
KAVITA_DOCS_PATH=./local/kavita/docs
