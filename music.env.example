# Copy to ignored music.env; paths are relative to compose.music.yaml.
MUSIC_PROJECT_NAME=multisuite-music
NAVIDROME_IMAGE=navidrome/navidrome:0.64.2
NAVIDROME_UID=1000
NAVIDROME_GID=1000
NAVIDROME_PORT=4533
NAVIDROME_MUSIC_PATH=./local/navidrome/music
NAVIDROME_DATA_PATH=./local/navidrome/data
# Empty for direct local access. Set /music only when the proxy preserves it.
NAVIDROME_BASE_URL=
