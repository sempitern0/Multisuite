# music.env — Música con Navidrome (compose.music.yaml). Guía: docs/NAVIDROME.md
# Activar: cp music.env.example music.env; `make up` arranca Música. Sin este archivo no se arranca
# (MUSIC_AUTO=0 lo salta). Solo nombres, puertos y rutas; las rutas son relativas a la raíz.

# --- Contenedores --------------------------------------------------------------------------
MUSIC_PROJECT_NAME=multisuite-music
NAVIDROME_IMAGE=navidrome/navidrome:0.64.2
# Usuario y grupo dueños de los archivos de Navidrome (el tuyo: `id -u` / `id -g`).
NAVIDROME_UID=1000
NAVIDROME_GID=1000

# --- Acceso --------------------------------------------------------------------------------
# Puerto en este equipo (solo 127.0.0.1). La dirección que abre el portal es PORTAL_MUSIC_URL
# en app/.env (`make up` la rellena sola en desarrollo).
NAVIDROME_PORT=4533
# Vacío para acceso directo. «/music» solo si un proxy sirve Navidrome bajo esa subruta.
NAVIDROME_BASE_URL=
# Dirección de la pasarela de Música cuando no es http://127.0.0.1:NAVIDROME_PORT (con la red
# privada, su nombre privado): Navidrome vuelve ahí al cerrar sesión. Sin barra final.
# MUSIC_PUBLIC_ORIGIN=https://musica.example.org

# --- Datos ---------------------------------------------------------------------------------
# Biblioteca de música (solo lectura para Navidrome) y base de datos del servicio.
NAVIDROME_MUSIC_PATH=./local/navidrome/music
NAVIDROME_DATA_PATH=./local/navidrome/data
