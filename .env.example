# .env — Infraestructura de desarrollo: qué contenedores arranca `make up` y en qué puertos.
# Lo crean `make setup`/`make env-sync` a partir de esta plantilla; `make env-sync` añade las
# claves nuevas sin tocar tus valores. Laravel tiene su propio app/.env (lo rellena `make up`).
# Índice de todos los archivos de entorno: `make env-list` o docs/ENVIRONMENTS.md.

# --- Proyecto ------------------------------------------------------------------------------
PROJECT_NAME=foundry
APP_LABEL="Laravel Foundry"
# 1 cuando el asistente de `make setup` ya se completó.
SETUP_CONFIGURED=0
# Perfiles de Compose activos (base de datos, correo de pruebas, herramientas de desarrollo).
COMPOSE_PROFILES=postgres,mailpit,dev
# Tu usuario y grupo en el equipo (`id -u` / `id -g`): dueños de los archivos que crean los contenedores.
DEV_UID=1000
DEV_GID=1000

# --- Base de datos -------------------------------------------------------------------------
DB_ENGINE=postgres
DB_SERVER=postgres
DB_DATABASE=foundry
DB_USERNAME=foundry
DB_PASSWORD=local-only-change-me
DB_ROOT_PASSWORD=local-only-root-change-me
# Panel web de la base de datos: none, pgweb, phpmyadmin o adminer (solo en 127.0.0.1).
DB_UI=none
DB_UI_PORT=8081

# --- Colas y correo ------------------------------------------------------------------------
QUEUE_ENGINE=sync
# mailpit: los correos se ven en http://127.0.0.1:MAILPIT_PORT y no salen del equipo.
MAIL_ENGINE=mailpit
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.test
MAILPIT_PORT=8025

# --- Acceso al portal ----------------------------------------------------------------------
# El portal en http://127.0.0.1:HTTP_PORT. HTTPS local opcional (`make https-setup`).
HTTP_PORT=8080
HTTPS_ENABLED=0
HTTPS_PORT=443
LOCAL_DOMAIN=foundry.test
VITE_PORT=5173
CADDY_LOCAL_CONFIG_FILE=./docker/caddy/Caddyfile.local
# Puerto de Komga en este equipo (Lectura; arranca solo con el NAS de desarrollo).
# KOMGA_PORT=25600

# --- Música: entrada desde el portal (solo con music.env) ----------------------------------
# Con music.env, `make up` pasa estos dos valores al portal y mandan sobre los de app/.env.
# false solo si PORTAL_MUSIC_URL no pasa por la pasarela de Música.
NAVIDROME_SESSION_BRIDGE_ENABLED=true
NAVIDROME_AUTOLOGIN_ENABLED=true
