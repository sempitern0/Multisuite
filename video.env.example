# video.env — Vídeo con Jellyfin (compose.video.yaml). Guía: docs/JELLYFIN.md
# Activar: `make video-detect` (lo crea y elige la aceleración) o cp video.env.example video.env;
# `make up` arranca Vídeo (VIDEO_AUTO=0 lo salta). Solo nombres, puertos y rutas.

# --- Contenedores --------------------------------------------------------------------------
VIDEO_PROJECT_NAME=multisuite-video
JELLYFIN_IMAGE=jellyfin/jellyfin:10.11.11
# Usuario y grupo dueños de los archivos de Jellyfin (el tuyo: `id -u` / `id -g`).
VIDEO_UID=1000
VIDEO_GID=1000

# --- Acceso --------------------------------------------------------------------------------
# Puerto en este equipo (solo 127.0.0.1).
VIDEO_PORT=8096
# Dirección que abren las personas y las apps de Jellyfin; `make up` la pasa también al portal.
# Sin barra final. Con la red privada, el nombre privado de Vídeo (`make vpn-urls`).
PORTAL_VIDEO_URL=http://127.0.0.1:8096

# --- Películas y series para todos ---------------------------------------------------------
# Carpeta del NAS ya existente, de solo lectura. En desarrollo se usa el NAS de desarrollo.
# VIDEO_COMMON_PATH=/srv/nas/peliculas

# --- Aceleración por hardware (lo escribe `make video-detect`) -----------------------------
# intel, amd, nvidia o none (procesador; lo seguro si dudas).
VIDEO_HARDWARE=none
# Grupo del dispositivo /dev/dri/renderD128 (intel y amd): `stat -c %g /dev/dri/renderD128`.
VIDEO_RENDER_GID=109
