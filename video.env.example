# Copy to ignored video.env (or run `make video-detect`, which creates it). Paths are relative
# to compose.video.yaml.
VIDEO_PROJECT_NAME=multisuite-video
JELLYFIN_IMAGE=jellyfin/jellyfin:10.11.11
VIDEO_UID=1000
VIDEO_GID=1000
VIDEO_PORT=8096
# Existing NAS folder with films and series for everyone (read-only). Development uses the
# development NAS volume instead.
# VIDEO_COMMON_PATH=/srv/nas/peliculas
# Address people open (also used by Jellyfin's apps). No trailing slash.
PORTAL_VIDEO_URL=http://127.0.0.1:8096
# Written by `make video-detect`: intel, amd, nvidia or none (CPU, the default when unsure).
VIDEO_HARDWARE=none
VIDEO_RENDER_GID=109
